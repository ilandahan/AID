# ============================================
# AID Environment Configuration Template
# Non-secret settings only. Copy to .env if you use them.
#
# Never put a token, API key or password in this file or in .env.
# Store secrets in your OS keystore and export them into the shell you start
# `claude` from: SSO/OAuth > OS keystore > environment variable > never a file.
# See INSTALLATION.md, "MCP Integrations Setup" (macOS Keychain `security`,
# Windows Credential Manager `cmdkey` / `Get-StoredCredential`, Linux `secret-tool`).
# ============================================

# ================== Application ==================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ================== Database ==================
# Credentials for a real database come from the keystore, not from here.
# For SQLite (development): DATABASE_URL=file:./dev.db

# ================== Redis (Optional) ==================
REDIS_URL=redis://localhost:6379

# ================== Authentication ==================
NEXTAUTH_URL=http://localhost:3000

# ================== External Services ==================
# Jira / Atlassian (not secrets; the API token comes from the keystore).
# Preferred: Atlassian's official remote MCP server with OAuth sign-in (no token at all).
# ATLASSIAN_SITE_NAME is the subdomain only (your-org for your-org.atlassian.net):
# the pinned @aashari/mcp-server-atlassian-* 3.3.0 servers read this name.
ATLASSIAN_SITE_NAME=your-org
ATLASSIAN_USER_EMAIL=your-email@company.com

# ================== Nano Banana Pro (Optional) ==================
# AI-powered visual artifact generation - OPTIONAL feature.
# The provider key comes from the keystore (see skills/nano-banana-visual/SKILL.md).
# NANO_BANANA_PROVIDER=google
# Vertex AI (enterprise) settings are not secrets:
# VERTEX_PROJECT_ID=your-gcp-project-id
# VERTEX_LOCATION=us-central1

# ================== Feature Flags ==================
ENABLE_DEV_TOOLS=true
ENABLE_DEBUG_LOGGING=true
ENABLE_NANO_BANANA=false

# ================== Telemetry ==================
# Set to 1 to disable telemetry
# NEXT_TELEMETRY_DISABLED=1

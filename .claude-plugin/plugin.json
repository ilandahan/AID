{
  "name": "aid",
  "version": "3.0.7",
  "displayName": "AID",
  "icon": "./.claude-plugin/icon.png",
  "description": "AI Development Methodology: 6 phase gates from discovery to ship, 27 skills, 39 review sub-agents, and WHY-first enforcement hooks. Stops code being written before the problem is understood.",
  "author": {
    "name": "Ilan Dahan",
    "url": "https://github.com/ilandahan/AID"
  },
  "homepage": "https://github.com/ilandahan/AID",
  "privacyPolicyUrl": "https://github.com/ilandahan/AID#data-handling-and-privacy",
  "repository": "https://github.com/ilandahan/AID",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "methodology",
    "phase-gates",
    "prd",
    "tech-spec",
    "code-review",
    "bdd",
    "cucumber",
    "tdd",
    "data-science"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "statusMessage": "Loading AID phase and context...",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook-runner.mjs",
              "session-start"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "statusMessage": "AID phase gate (writes)...",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook-runner.mjs",
              "phase-gate-write"
            ]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "statusMessage": "AID phase gate (commands)...",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook-runner.mjs",
              "phase-gate-bash"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 30,
            "statusMessage": "Initializing dev pipeline for approved plan...",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook-runner.mjs",
              "plan-approved"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 120,
            "statusMessage": "Language checks + pipeline freshness...",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook-runner.mjs",
              "stop-pipeline"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 60,
            "statusMessage": "QA gate validation (Phase 4 only)",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook-runner.mjs",
              "stop-qa"
            ]
          }
        ]
      }
    ]
  }
    }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business Analyst Agent Response",
  "type": "object",
  "required": ["report", "meta"],
  "properties": {
    "report": {
      "type": "string",
      "description": "Complete markdown Business Analysis Report with traceability IDs [BA-XXX] on every finding"
    },
    "meta": {
      "type": "object",
      "required": ["total_findings", "confidence_level", "confidence_rationale", "opportunity_score", "research_gaps", "key_assumptions", "recommended_interviews"],
      "properties": {
        "total_findings": { "type": "integer", "minimum": 0 },
        "confidence_level": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "confidence_rationale": { "type": "string" },
        "opportunity_score": {
          "type": "object",
          "required": ["user_value", "business_value", "strategic_fit", "feasibility", "risk_level", "composite"],
          "properties": {
            "user_value": { "type": "integer", "minimum": 1, "maximum": 10 },
            "business_value": { "type": "integer", "minimum": 1, "maximum": 10 },
            "strategic_fit": { "type": "integer", "minimum": 1, "maximum": 10 },
            "feasibility": { "type": "integer", "minimum": 1, "maximum": 10 },
            "risk_level": { "type": "integer", "minimum": 1, "maximum": 10 },
            "composite": { "type": "number" }
          }
        },
        "research_gaps": { "type": "array", "items": { "type": "string" } },
        "key_assumptions": { "type": "array", "items": { "type": "string" } },
        "recommended_interviews": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Competitive Researcher Agent Response",
  "type": "object",
  "required": ["report", "meta"],
  "properties": {
    "report": {
      "type": "string",
      "description": "Complete markdown Competitive Landscape Report with traceability IDs [CR-XXX] on every finding"
    },
    "meta": {
      "type": "object",
      "required": ["competitors_identified", "total_findings", "confidence_level", "confidence_rationale", "top_opportunities", "top_threats", "research_gaps", "recommended_research"],
      "properties": {
        "competitors_identified": {
          "type": "object",
          "required": ["direct", "indirect", "substitutes"],
          "properties": {
            "direct": { "type": "integer", "minimum": 0 },
            "indirect": { "type": "integer", "minimum": 0 },
            "substitutes": { "type": "integer", "minimum": 0 }
          }
        },
        "total_findings": { "type": "integer", "minimum": 0 },
        "confidence_level": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "confidence_rationale": { "type": "string" },
        "top_opportunities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "opportunity", "type"],
            "properties": {
              "id": { "type": "string", "pattern": "^CR-\\d{3}$" },
              "opportunity": { "type": "string" },
              "type": { "type": "string", "enum": ["WHITE_SPACE", "UNDERSERVED", "DIFFERENTIATION"] }
            }
          }
        },
        "top_threats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "threat", "severity"],
            "properties": {
              "id": { "type": "string", "pattern": "^CR-\\d{3}$" },
              "threat": { "type": "string" },
              "severity": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] }
            }
          }
        },
        "research_gaps": { "type": "array", "items": { "type": "string" } },
        "recommended_research": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

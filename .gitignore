# ============================================
# AID Repository .gitignore
# Next.js + TypeScript + Python Testing
# ============================================

# ================== Dependencies ==================
node_modules/
.pnp/
.pnp.js
.yarn/install-state.gz

# ================== Next.js Build ==================
.next/
out/
build/
dist/
.swc/

# ================== TypeScript ==================
*.tsbuildinfo
next-env.d.ts

# ================== Testing ==================
coverage/
.nyc_output/
test-results/
playwright-report/
reports/
test-recordings/
!test-recordings/.gitkeep

# Python Testing
.pytest_cache/
__pycache__/
*.py[cod]
*$py.class
.coverage
htmlcov/
.tox/
.nox/
*.egg-info/
.eggs/

# Python tooling caches / local envs
.mypy_cache/
.ruff_cache/
.deepeval/
.deepeval_telemetry.txt
.venv/
venv/

# ================== Environment ==================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Keep example
!.env.example

# ================== IDE & Editors ==================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ================== OS Files ==================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ================== Logs ==================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ================== Debug ==================
.pnpm-debug.log*

# ================== Misc ==================
*.pem
*.key
*.crt

# Sentry
.sentryclirc

# Vercel
.vercel

# Turbo
.turbo

# ================== AID Specific ==================
# NOTE: scripts/ is TRACKED - it holds init-project.sh, which package.json's
# "new-project" and the /start-project command both invoke. It was previously ignored
# by an unanchored "scripts/" rule, which also matched EVERY directory named scripts at
# any depth and silently excluded three real skill scripts
# (role-developer/scripts/, role-qa-engineer/scripts/) from the repo.

# State files (contain session-specific data)
.aid/state.json
.aid/context.json
.aid/session-state.json

# Feedback (contains session-specific data, may have PII)
.aid/feedback/

# QA enforcement log (runtime)
.aid/qa/enforcement.log

# Local Claude settings (user-specific permissions).
# WHY: this file is per-machine. A tracked allow-list would hand every adopter
# unprompted Bash(powershell:*) / Bash(curl:*) / Bash(gcloud:*) approval.
.claude/settings.local.json

# Agent worktrees / scratch checkouts
.claude/worktrees/

# Test outputs (generated by agent tests)
.aid/test-outputs/
.aid/agent-tests/

# QA review files (generated during development)
.aid/qa/*-review-*.json

# Pipeline runtime state (per-session, not shared)
# Defensive: ignore all pipeline runtime files except config
.aid/pipeline/*
!.aid/pipeline/config.json

# Demo/scratch files (not part of AID framework)
churn_*.py
clean_churn.py

# Keep templates and example files
!templates/.aid/
!.aid/qa/EXAMPLE-TASK.yaml

# Local MCP config (contains YOUR tokens - never committed)
.mcp.json

# The two files below are TRACKED TEMPLATES and must hold placeholders only.
# They sit one character away from the ignored .mcp.json above, which is exactly
# how a real Atlassian token once got published. Put real values in .mcp.json.
# testing/e2e/test_link_project_guards.py fails the build if a credential-shaped
# string appears in either of them.
!.mcp.json.windows
!.mcp.json.mac

# ================== Docker ==================
# Ignore docker compose override (local customizations)
docker-compose.override.yml
docker-compose.local.yml

# ================== Database ==================
*.sqlite
*.sqlite3
*.db
prisma/migrations/**/migration_lock.toml

# ================== Temporary Files ==================
tmp/
temp/
.tmp/
.temp/
*.tmp
*.temp

# ================== Package Locks ==================
# Uncomment if you want to ignore lock files (not recommended)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ================== Secrets & Keys ==================
secrets/
.secrets/
*.secret
*_secret.*
credentials.json
service-account.json

# ================== Generated Files ==================
generated/
.generated/
*.generated.*
nul

{
  "mcpServers": {
    "filesystem": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-filesystem@2.1.0", "."]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "chrome-devtools-mcp@1.12.0", "--no-usage-statistics", "--no-performance-crux"]
    },
    "jira": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@aashari/mcp-server-atlassian-jira@3.3.0"],
      "env": {
        "ATLASSIAN_SITE_NAME": "${ATLASSIAN_SITE_NAME:-}",
        "ATLASSIAN_USER_EMAIL": "${ATLASSIAN_USER_EMAIL:-}",
        "ATLASSIAN_API_TOKEN": "${ATLASSIAN_API_TOKEN:-}"
      }
    },
    "confluence": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@aashari/mcp-server-atlassian-confluence@3.3.0"],
      "env": {
        "ATLASSIAN_SITE_NAME": "${ATLASSIAN_SITE_NAME:-}",
        "ATLASSIAN_USER_EMAIL": "${ATLASSIAN_USER_EMAIL:-}",
        "ATLASSIAN_API_TOKEN": "${ATLASSIAN_API_TOKEN:-}"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN:-}"
      }
    }
  }
}
